{
  "name": "@eddieonthecode/nest-core",
  "version": "0.1.0",
  "description": "A useful package to help build REST APIs faster and more effectively with NestJS and TypeORM",
  "author": "Eddie on the Code",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/typeorm": "^10.0.0 || ^11.0.0",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.17"
  },
  "dependencies": {
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "dayjs": "^1.11.19",
    "typeorm-naming-strategies": "^4.1.0",
    "nestjs-typeorm-paginate": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/typeorm": "^10.0.0 || ^11.0.0",
    "@types/node": "^20.0.0",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.17",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "nestjs",
    "typeorm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eddieonthecode/nest-core.git"
  }
}